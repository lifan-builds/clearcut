{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "clearcut-catalog-edge",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "bigring.clifan.com", "custom_domain": true },
    { "pattern": "benchdrop.clifan.com", "custom_domain": true },
    { "pattern": "tideline.clifan.com", "custom_domain": true },
    { "pattern": "highline.clifan.com", "custom_domain": true }
  ]
}
