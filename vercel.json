{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/vercel_build.py",
  "env": {
    "DEALS_DB_READ_ONLY": "1",
    "TURSO_DIRECT_CONNECTION": "1",
    "DISABLE_APP_LIFESPAN": "1",
    "AUTH_DB_PATH": "/tmp/auth_replica.db"
  },
  "functions": {
    "api/index.py": {
      "excludeFiles": "{catalogs/fresh-powder/data/deals.db,common/tests/**,catalogs/*/tests/**,catalogs/*/tampermonkey/**,docs/**,.pytest_cache/**,**/__pycache__/**}",
      "includeFiles": "{catalogs/fresh-powder/data/deals.db.gz,catalogs/fresh-powder/data/deals.db.manifest.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(static|portal-static)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "snow-deal.vercel.app"
        }
      ],
      "destination": "https://freshpowder.clifan.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "snow-deal.vercel.app"
        }
      ],
      "destination": "https://freshpowder.clifan.com/:path*",
      "permanent": true
    }
  ]
}
